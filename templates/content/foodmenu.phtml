<?php $articles = json_decode(file_get_contents('src/pseudo-articles.json'), true); // Pseudo-Artikel-Datenbank ?>

<div class="container">
    <div class="row">
        <div class="col text-center">
            <h2>Speisekarte</h2>
        </div>
    </div>
    <div id="foodfilter">
        <div class="row">
            <div class="col-sm-12 d-flex flex-wrap justify-content-center mb-4">
                <button type="button" class="btn d-block m-1 active" category="all"><b>All</b></button>
                <?php $categories = []; foreach ($articles as $item) {$categories[$item["category"]] = true;} foreach (array_keys($categories) as $category): ?>
                    <button type="button" class="btn d-block m-1" category="<?=ucfirst($category)?>"><b><?=ucfirst($category)?></b></button>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
    <div id="foodlist">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5">

