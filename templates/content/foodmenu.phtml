            <a href="javascript();" class="item active col text-center" category="<?=$article['category']?>" ean="<?=$article['ean']?>" data-bs-toggle="modal" data-bs-target="#foodmodal">
                <p class="image mb-1">
                    <img src="<?=$article['image']?>" class="img-fluid rounded" alt="food" />
                </p>
                <p class="textbox">
                    <span class="title"><b><?=$article['name']?></b></span><br>
                    <span class="price fw-light"><?=$article['price']?> €</span>
                </p>
                <div class="d-none">
                    <div class="description"><p><?=$article['description']?></p></div>
                    <div class="additives"><p><?=$article['additives']?></p></div>
                    <div class="calories"><p><?=$article['calories']?> Kalorien</p></div>
                </div>
            </a>
        <?php endforeach; ?>

        </div>
    </div>
</div>